POSTGRES_DB=bookclub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django settings
DEBUG=True
ALLOWED_HOSTS=*
# For local development: http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1,http://localhost
# For production: https://your-domain.railway.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1,http://localhost

# Public deployment URL (use http://127.0.0.1:8000 in local development).
SITE_URL=http://127.0.0.1:8000
SOCIAL_AUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000
SECURE_SSL_REDIRECT=false

# Google OAuth 2.0 / OpenID Connect
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft identity platform. Use "common" for personal and work/school accounts.
# Get credentials from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Sign in with Apple. APPLE_CLIENT_SECRET is the server-generated Apple client secret JWT.
# Get credentials from: https://developer.apple.com/account/resources/identifiers/list
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email configuration for password reset
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@afrinovel.com
