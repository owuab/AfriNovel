POSTGRES_DB=bookclub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django settings
DEBUG=False
ALLOWED_HOSTS=*
# For local development: http://127.0.0.1:8000,http://localhost:8000
# For production: https://your-domain.railway.app
CSRF_TRUSTED_ORIGINS=https://afrinovel-production.up.railway.app

# Public deployment URL (use http://127.0.0.1:8000 in local development).
SITE_URL=http://127.0.0.1:8000
SOCIAL_AUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000
SECURE_SSL_REDIRECT=false

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft identity platform. Use "common" for personal and work/school accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Sign in with Apple. APPLE_CLIENT_SECRET is the server-generated Apple client secret JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
